 .assessment-actions{display:flex;align-items:center;justify-content:space-between;margin-top:20px}.assessment-actions .primary-button{margin-top:0}
 .assessment-view{padding:41px 42px 60px;max-width:900px;margin:0 auto}.assessment-card,.assessment-result{background:#fff;border:1px solid var(--line);border-radius:10px;padding:22px;box-shadow:var(--shadow)}.assessment-question{border:0;border-bottom:1px solid #edf1ed;padding:20px 0;margin:0}.assessment-question legend{display:flex;align-items:flex-start;gap:12px;font-family:'Space Grotesk';font-size:16px;line-height:1.4;padding:0;margin-bottom:14px}.assessment-question legend span{display:grid;place-items:center;width:26px;height:26px;background:var(--mint);color:var(--deep-green);border-radius:50%;font-size:10px;flex-shrink:0}.assessment-question label{display:inline-flex;align-items:center;margin:5px 8px 0 38px;border:1px solid var(--line);border-radius:6px;padding:9px 12px;color:var(--muted);font-size:11px;cursor:pointer}.assessment-question input{accent-color:var(--green);margin-right:7px}.assessment-question label:has(input:checked){border-color:var(--green);background:#f1f7f2;color:var(--deep-green)}.assessment-card>.primary-button{margin-top:20px;font-size:11px;padding:9px 11px}.assessment-result{display:flex;align-items:center;gap:12px;margin-top:15px;background:#d7eee3;color:var(--deep-green)}.assessment-result strong{font-family:'Space Grotesk';font-size:27px}.assessment-result span{font-size:11px}.assessment-result p{border-left:1px solid #a9d0ba;padding-left:12px;font-size:11px;margin-left:auto;max-width:360px;line-height:1.5}
@media(max-width:700px){.assessment-view{padding:27px 16px 35px}.assessment-question label{margin-left:0}.assessment-result{align-items:flex-start;flex-wrap:wrap}.assessment-result p{border-left:0;border-top:1px solid #a9d0ba;padding:10px 0 0;margin:0;max-width:none;width:100%}}
 .certifications-view{padding:41px 42px 60px;max-width:1200px;margin:0 auto}.certification-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.certification-card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:21px;box-shadow:var(--shadow)}.certification-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:9px;background:#fff0c5;color:#a9791a;margin-bottom:19px}.certification-card h2{font-family:'Space Grotesk';font-size:18px;line-height:1.25;margin:9px 0 8px}.certification-card p{color:var(--muted);font-size:11px;margin:0 0 25px}.certification-card p strong{color:var(--ink)}.certification-footer{display:flex;justify-content:space-between;align-items:center;gap:8px}.certification-status{color:#ae633b;background:#fff1df;border-radius:10px;padding:5px 8px;font-size:9px;font-weight:700;text-transform:uppercase}.certification-status.complete{color:var(--deep-green);background:var(--mint)}.certification-action{font-size:10px;padding:8px 10px}.certification-action:disabled{background:#edf3ee;color:var(--deep-green);border-color:#dce9df;cursor:default}
@media(max-width:700px){.certifications-view{padding:27px 16px 35px}.certification-grid{grid-template-columns:1fr}}
 .show-password{display:flex!important;align-items:center;gap:7px;color:var(--muted);font-size:10px!important;font-weight:400!important}.show-password input{width:auto!important;accent-color:var(--green)}
 .signout-button{border:0;background:none;color:#a4776a;font-size:11px;padding:15px 0 0;cursor:pointer}.signout-button:hover{color:#b34f37}
 .login-screen{min-height:100vh;background:radial-gradient(circle at 80% 20%,#d7eee3 0,#f6f7f3 38%,#f6f7f3 100%);padding:28px 7vw;color:var(--ink)}.login-brand{display:flex;align-items:center;gap:9px;font-family:'Space Grotesk';font-size:19px;font-weight:700}.login-layout{max-width:1080px;margin:11vh auto 0;display:grid;grid-template-columns:1.15fr .85fr;gap:10vw;align-items:center}.login-intro h1{font-family:'Space Grotesk';font-size:clamp(40px,5vw,70px);line-height:1.02;letter-spacing:-2px;max-width:580px;margin:18px 0}.login-intro>p:not(.eyebrow){color:var(--muted);font-size:16px;line-height:1.6;max-width:470px}.login-proof{display:flex;align-items:center;gap:13px;margin-top:42px}.login-proof>span{font-family:'Space Grotesk';font-size:34px;color:var(--deep-green)}.login-proof strong,.login-proof small{display:block}.login-proof strong{font-size:12px}.login-proof small{color:var(--muted);font-size:11px;margin-top:3px}.login-card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:30px;box-shadow:0 22px 55px rgba(35,65,52,.13)}.login-card h2{font-family:'Space Grotesk';font-size:25px;margin:7px 0 25px}.login-card label{display:block;color:var(--muted);font-size:11px;font-weight:700;margin:14px 0 6px}.login-card input{width:100%;border:1px solid #cfddd5;border-radius:7px;padding:12px;font:inherit;font-size:12px;outline:0}.login-card input:focus{border-color:var(--green);box-shadow:0 0 0 3px var(--mint)}.login-card .primary-button{width:100%;justify-content:center;margin-top:22px;padding:11px}.login-error{background:#fff0ed;color:#ad4f3d;border-radius:5px;padding:9px;font-size:11px;line-height:1.4}.login-hint{display:block;color:#9aa59f;font-size:10px;line-height:1.4;margin-top:17px}.app-shell:not(.authenticated){display:none}
@media(max-width:700px){.login-screen{padding:22px 20px}.login-layout{display:block;margin-top:12vh}.login-intro h1{font-size:40px;letter-spacing:-1px}.login-intro>p:not(.eyebrow){font-size:13px}.login-proof{margin:25px 0 30px}.login-card{padding:22px}}
 .application-note{display:flex;gap:6px;margin:0 0 11px;padding:8px;background:#fff8e8;color:#79633c;border-radius:5px;font-size:10px;line-height:1.4}.application-note .icon{flex-shrink:0;font-size:12px}
 .note-application{border:0;background:none;color:var(--green);font-size:10px;padding:8px 0 0;cursor:pointer}.note-application:hover{color:var(--deep-green)}
 .heading-actions{display:flex;gap:8px}.heading-actions .primary-button{font-size:11px;padding:9px 11px}.add-application-panel{position:fixed;z-index:33;top:50%;left:50%;transform:translate(-50%,-46%);width:min(420px,calc(100vw - 32px));padding:22px;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:0 22px 55px rgba(35,65,52,.22);opacity:0;pointer-events:none;transition:.2s ease}.add-application-panel.open{transform:translate(-50%,-50%);opacity:1;pointer-events:auto}.add-application-panel form label{display:block;color:var(--muted);font-size:11px;font-weight:700;margin:13px 0 6px}.add-application-panel form input{width:100%;border:1px solid #cfddd5;border-radius:6px;padding:10px;font:inherit;font-size:12px}.add-application-panel form button{margin-top:18px;font-size:11px;padding:9px 11px}
@media(max-width:700px){.heading-actions{width:100%;flex-wrap:wrap}.heading-actions .outline-button,.heading-actions .primary-button{flex:1}.add-application-panel{padding:19px}}
 .remove-application{border:0;background:none;color:#a4776a;font-size:10px;padding:7px 0 0;cursor:pointer}.remove-application:hover{color:#b34f37;text-decoration:underline}
 .application-toolbar{display:flex;gap:12px;margin-bottom:18px}.application-toolbar .jobs-search{max-width:500px}.application-toolbar select{border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);padding:0 14px;font:inherit;font-size:12px}
@media(max-width:700px){.application-toolbar{flex-direction:column}.application-toolbar .jobs-search{max-width:none}.application-toolbar select{padding:12px 14px}}
 .profile-label{display:block;color:var(--muted);font-size:10px;font-weight:700;margin:12px 0 5px}.profile-input{width:100%;border:1px solid #cfddd5;border-radius:6px;padding:9px;font:inherit;font-size:12px;outline:0}.profile-input:focus{border-color:var(--green)}#profileForm .primary-button{margin:15px 0 20px;font-size:11px;padding:9px 11px}
 .role-panel{position:fixed;z-index:33;top:50%;left:50%;transform:translate(-50%,-46%);width:min(460px,calc(100vw - 32px));padding:22px;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:0 22px 55px rgba(35,65,52,.22);opacity:0;pointer-events:none;transition:.2s ease}.role-panel.open{transform:translate(-50%,-50%);opacity:1;pointer-events:auto}.role-panel h2{font-family:'Space Grotesk';font-size:25px;margin:18px 0 5px}.role-panel>p{color:var(--muted);font-size:12px}.role-match{display:inline-block;background:var(--mint);color:var(--deep-green);font-family:'Space Grotesk';font-weight:700;font-size:18px;border-radius:7px;padding:11px 14px;margin:10px 0}.role-description{line-height:1.55;margin:15px 0}.role-panel .chips{margin-bottom:20px}.role-panel>#saveRole{font-size:11px;padding:9px 11px}
 .goal-panel{position:fixed;z-index:32;top:50%;left:50%;transform:translate(-50%,-46%);width:min(430px,calc(100vw - 32px));padding:22px;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:0 22px 55px rgba(35,65,52,.22);opacity:0;pointer-events:none;transition:.2s ease}.goal-panel.open{transform:translate(-50%,-50%);opacity:1;pointer-events:auto}.goal-panel>p{color:var(--muted);font-size:12px;margin:0 0 15px}.goal-options{display:grid;gap:8px}.goal-option{display:flex;align-items:center;justify-content:space-between;border:1px solid var(--line);background:#fff;border-radius:7px;padding:13px;color:var(--ink);text-align:left}.goal-option:hover,.goal-option.selected{border-color:var(--green);background:#f1f7f2;color:var(--deep-green)}.goal-option strong{font-family:'Space Grotesk';font-size:13px}.goal-option .icon{font-size:15px}
 .search-panel{position:fixed;z-index:31;top:82px;left:50%;transform:translateX(-50%) translateY(-8px);width:min(560px,calc(100vw - 32px));padding:22px;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:0 22px 55px rgba(35,65,52,.2);opacity:0;pointer-events:none;transition:.2s ease}.search-panel.open{transform:translateX(-50%) translateY(0);opacity:1;pointer-events:auto}.search-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.search-header h2{font-family:'Space Grotesk';font-size:19px;margin:0}.global-search{display:flex;align-items:center;gap:10px;padding:0 13px;border:1px solid #cfddd5;border-radius:7px;color:var(--muted)}.global-search input{width:100%;border:0;outline:0;padding:12px 0;font:inherit;font-size:12px}.search-results{margin-top:11px}.search-results>p{color:var(--muted);font-size:12px;text-align:center;padding:20px}.search-result{position:relative;display:flex;flex-direction:column;align-items:flex-start;width:100%;border:0;border-bottom:1px solid #edf1ed;background:#fff;padding:12px 28px 12px 0;text-align:left}.search-result:last-child{border-bottom:0}.search-result strong{font-size:13px;margin:4px 0}.search-result small{color:var(--muted);font-size:10px}.search-result>.icon{position:absolute;right:4px;top:24px;color:var(--green)}
@media(max-width:700px){.search-panel{top:70px}}
 .notification-panel{position:fixed;z-index:29;right:24px;top:70px;width:min(360px,calc(100vw - 32px));padding:18px;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:0 18px 45px rgba(35,65,52,.16);transform:translateY(-8px);opacity:0;pointer-events:none;transition:.2s ease}.notification-panel.open{transform:translateY(0);opacity:1;pointer-events:auto}.notification-header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:12px}.notification-header h2{font-family:'Space Grotesk';font-size:18px;margin:0}.notification-item{display:flex;justify-content:space-between;gap:10px;padding:14px 0;border-bottom:1px solid #edf1ed}.notification-item:last-child{border-bottom:0}.notification-item strong{font-size:12px}.notification-item p{color:var(--muted);font-size:11px;line-height:1.45;margin:4px 0}.notification-item small{color:#a0aaa5;font-size:10px}.notification-item.unread{background:#f7fbf8;margin:0 -8px;padding-left:8px;padding-right:8px;border-radius:5px}.unread-dot{width:7px;height:7px;background:var(--coral);border-radius:50%;flex-shrink:0;margin-top:4px}.notification.has-unread:after{content:'';position:absolute;width:6px;height:6px;background:var(--coral);border-radius:50%;margin:-2px 0 0 -6px}
@media(max-width:700px){.notification-panel{right:16px;top:64px}}
 .settings-view{padding:41px 42px 60px;max-width:1000px;margin:0 auto}.settings-layout{display:grid;grid-template-columns:1fr 1.4fr;gap:15px}.settings-card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:22px;box-shadow:var(--shadow)}.settings-profile{display:flex;align-items:center;gap:12px;margin:20px 0 27px}.settings-profile h2{font-family:'Space Grotesk';font-size:18px;margin:0}.settings-profile p{color:var(--muted);font-size:11px;margin:3px 0}.settings-field{border-top:1px solid var(--line);padding-top:17px}.settings-field label{display:block;color:var(--muted);font-size:10px;margin-bottom:5px}.settings-field strong{font-family:'Space Grotesk';font-size:14px}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:16px 0;border-bottom:1px solid #edf1ed;cursor:pointer}.setting-row strong,.setting-row small{display:block}.setting-row strong{font-size:12px}.setting-row small{color:var(--muted);font-size:10px;margin-top:3px}.setting-row input{position:absolute;opacity:0}.toggle{width:36px;height:20px;background:#dfe8e1;border-radius:15px;position:relative;flex-shrink:0}.toggle:after{content:'';position:absolute;width:16px;height:16px;left:2px;top:2px;background:#fff;border-radius:50%;transition:.2s;box-shadow:0 1px 3px #0002}.setting-row input:checked+.toggle{background:var(--green)}.setting-row input:checked+.toggle:after{transform:translateX(16px)}.settings-card>#saveSettings{margin-top:20px;font-size:11px;padding:9px 11px}
@media(max-width:700px){.settings-view{padding:27px 16px 35px}.settings-layout{grid-template-columns:1fr}}
 .projects-view{padding:41px 42px 60px;max-width:1200px;margin:0 auto}.project-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.project-card{background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden;box-shadow:var(--shadow)}.project-art{height:105px;display:grid;place-items:center;background:#253a41;color:#c8f2df;font-size:27px}.project-art.complete{background:#23654e;color:#fff}.project-card-body{padding:19px}.project-status{display:inline-block;text-transform:uppercase;font-size:9px;font-weight:700;letter-spacing:.8px;color:#b45c3e;background:#ffe9df;padding:5px 8px;border-radius:10px}.project-status.complete{color:var(--deep-green);background:var(--mint)}.project-status.planned{color:#667983;background:#edf1f3}.project-card h2{font-family:'Space Grotesk';font-size:18px;margin:10px 0 6px}.project-card p{color:var(--muted);font-size:11px;line-height:1.5;min-height:50px;margin:0 0 15px}.project-card .chips{margin-bottom:17px}.project-action{font-size:11px;padding:9px 11px;width:100%;justify-content:center}.project-action:disabled{background:#edf3ee;color:var(--deep-green);border-color:#dce9df;cursor:default}
@media(max-width:700px){.projects-view{padding:27px 16px 35px}.project-grid{grid-template-columns:1fr}}
 .skill-map-view{padding:41px 42px 60px;max-width:1200px;margin:0 auto}.skill-map-layout{display:grid;grid-template-columns:1fr 300px;gap:15px}.skill-map-card,.skill-detail{background:#fff;border:1px solid var(--line);border-radius:10px;padding:22px;box-shadow:var(--shadow)}.map-legend{display:flex;gap:15px;color:var(--muted);font-size:10px}.map-legend span{display:flex;align-items:center;gap:5px}.legend-dot{width:8px;height:8px;border-radius:50%;background:var(--green)}.legend-dot.developing{background:var(--coral)}.legend-dot.target{background:var(--navy)}.skill-nodes{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;padding:55px 30px}.skill-node{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;aspect-ratio:1;border:8px solid var(--mint);border-radius:50%;background:#f7fbf8;color:var(--deep-green);cursor:pointer;transition:.2s}.skill-node:hover,.skill-node.selected{transform:scale(1.06);box-shadow:0 0 0 5px #c8f2df}.skill-node.developing{border-color:#ffd5c6;color:#b45c3e}.skill-node.target{border-color:#cbd8df;color:var(--navy)}.skill-node strong{font-family:'Space Grotesk';font-size:12px}.skill-node span{font-size:10px}.skill-detail{align-self:start;text-align:center;min-height:250px}.skill-detail>.icon{color:var(--green);font-size:25px;margin-top:20px}.skill-detail h2{font-family:'Space Grotesk';font-size:20px;margin:15px 0 7px}.skill-detail p{color:var(--muted);font-size:12px;line-height:1.5}.skill-detail .detail-score{font-family:'Space Grotesk';font-size:32px;color:var(--deep-green);margin:18px 0 5px}.detail-score small{display:block;font-family:'DM Sans';font-size:10px;color:var(--muted)}.skill-detail .primary-button{margin-top:18px;font-size:11px;padding:9px 11px}
@media(max-width:700px){.skill-map-view{padding:27px 16px 35px}.skill-map-layout{grid-template-columns:1fr}.skill-nodes{padding:40px 10px;gap:12px}.skill-node{border-width:5px}}
 .analytics-view{padding:41px 42px 60px;max-width:1200px;margin:0 auto}.analytics-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.analytics-card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:22px;box-shadow:var(--shadow)}.analytics-row{margin:19px 0}.analytics-row>div:first-child{display:flex;justify-content:space-between;font-size:12px;margin-bottom:7px}.analytics-row strong{font-family:'Space Grotesk';color:var(--deep-green)}.analytics-track{height:8px;background:#e9efea;border-radius:8px;overflow:hidden}.analytics-track span{display:block;height:100%;border-radius:8px;background:var(--green)}.analytics-track.coral span{background:var(--coral)}.analytics-track.yellow span{background:var(--yellow)}.analytics-track.navy span{background:var(--navy)}.momentum-chart{height:170px;display:flex;align-items:flex-end;gap:12px;padding:15px 8px 0;border-bottom:1px solid var(--line);background:repeating-linear-gradient(to top,transparent 0,transparent 41px,#edf2ed 42px)}.momentum-chart span{flex:1;background:var(--deep-green);border-radius:5px 5px 0 0;min-height:8px}.momentum-chart span:nth-child(even){background:var(--coral)}.chart-days{display:flex;justify-content:space-between;color:var(--muted);font-size:10px;padding:8px 7px}.analytics-recommendation{display:flex;align-items:center;gap:15px;margin-top:15px;padding:19px 22px;background:#d7eee3;color:var(--deep-green);border-radius:10px}.analytics-recommendation>.icon{font-size:22px}.analytics-recommendation .eyebrow{color:#4c987c;margin:0 0 5px}.analytics-recommendation strong{font-family:'Space Grotesk';font-size:14px}.analytics-recommendation p{font-size:10px}
@media(max-width:700px){.analytics-view{padding:27px 16px 35px}.analytics-grid{grid-template-columns:1fr}.momentum-chart{gap:6px}}
 .mentorship-view{padding:41px 42px 60px;max-width:1200px;margin:0 auto}.mentor-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.mentor-card{position:relative;background:#fff;border:1px solid var(--line);border-radius:10px;padding:22px;box-shadow:var(--shadow)}.mentor-avatar{display:grid;place-items:center;width:52px;height:52px;border-radius:50%;background:#d7eee3;color:var(--deep-green);font-family:'Space Grotesk';font-weight:700;font-size:15px;margin-bottom:18px}.mentor-availability{position:absolute;right:18px;top:22px;color:var(--green);font-size:10px;font-weight:700}.mentor-card h2{font-family:'Space Grotesk';font-size:20px;margin:0 0 4px}.mentor-card>strong{font-size:12px}.mentor-card>p{color:var(--muted);font-size:11px;margin:4px 0 18px}.mentor-focus{padding:10px;background:#f1f7f2;color:#456458;border-radius:6px;font-size:11px;margin-bottom:18px}.mentor-action{font-size:11px;padding:9px 11px;width:100%;justify-content:center}.mentor-action:disabled{background:#edf3ee;color:var(--deep-green);border-color:#dce9df;cursor:default}
@media(max-width:700px){.mentorship-view{padding:27px 16px 35px}.mentor-grid{grid-template-columns:1fr}}
 .learning-view{padding:41px 42px 60px;max-width:1200px;margin:0 auto}.learning-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.learning-card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:21px;box-shadow:var(--shadow)}.learning-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:9px;margin-bottom:20px}.learning-icon.green{background:var(--mint);color:var(--deep-green)}.learning-icon.coral{background:#ffe0d4;color:#b45c3e}.learning-icon.yellow{background:#fff0c5;color:#a9791a}.learning-card h2{font-family:'Space Grotesk';font-size:19px;line-height:1.25;margin:7px 0}.learning-card p{color:var(--muted);font-size:11px;margin:0 0 20px}.learning-progress{margin-bottom:18px}.learning-progress>div:first-child{display:flex;justify-content:space-between;color:var(--muted);font-size:10px;margin-bottom:7px}.learning-progress strong{color:var(--deep-green)}.learning-card .progress-track{height:6px}.learning-card .progress-track>div{height:100%;background:var(--green);border-radius:8px}.learning-action{font-size:11px;padding:9px 11px;width:100%;justify-content:center}
@media(max-width:700px){.learning-view{padding:27px 16px 35px}.learning-grid{grid-template-columns:1fr}}
 .interview-view{padding:41px 42px 60px;max-width:1000px;margin:0 auto}.interview-badge{display:flex;align-items:center;gap:7px;padding:9px 12px;background:#d7eee3;color:var(--deep-green);border-radius:7px;font-size:11px;font-weight:700}.interview-card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:28px;box-shadow:var(--shadow)}.question-meta{display:flex;gap:10px;align-items:center;color:var(--muted);font-size:11px}.question-meta span:first-child{background:#fff1df;color:#ae633b;border-radius:12px;padding:5px 9px;font-weight:700}.interview-card h2{font-family:'Space Grotesk';font-size:25px;line-height:1.3;max-width:700px;margin:22px 0 28px}.interview-card label{display:block;color:var(--muted);font-size:11px;font-weight:700;margin-bottom:7px}.interview-card textarea{width:100%;resize:vertical;border:1px solid #cfddd5;border-radius:7px;padding:13px;font:inherit;font-size:12px;line-height:1.5;outline:0}.interview-card textarea:focus{border-color:var(--green);box-shadow:0 0 0 3px #c8f2df}.interview-footer{display:flex;justify-content:space-between;align-items:center;margin-top:15px}.interview-feedback{margin-top:20px;padding:16px;background:#f1f7f2;border-left:3px solid var(--green);border-radius:0 7px 7px 0;font-size:12px;line-height:1.5}.interview-feedback strong{font-family:'Space Grotesk';font-size:16px;color:var(--deep-green)}.interview-feedback p{margin:7px 0 0;color:#40584e}
@media(max-width:700px){.interview-view{padding:27px 16px 35px}.interview-card{padding:20px}.interview-card h2{font-size:21px}.interview-footer{align-items:flex-start;gap:14px;flex-direction:column}}
 .resume-view{padding:41px 42px 60px;max-width:1480px;margin:0 auto}.resume-layout{display:grid;grid-template-columns:300px 1fr;gap:15px}.resume-score,.resume-checklist{background:#fff;border:1px solid var(--line);border-radius:10px;padding:22px;box-shadow:var(--shadow)}.resume-ring{display:grid;place-items:center;width:110px;height:110px;border:9px solid var(--mint);border-right-color:var(--coral);border-radius:50%;font-family:'Space Grotesk';font-size:25px;color:var(--deep-green);margin:3px auto 22px}.resume-score h2{font-family:'Space Grotesk';font-size:19px;margin:0 0 7px}.resume-score p{color:var(--muted);font-size:12px;line-height:1.5;margin:0 0 20px}.resume-checklist .section-heading{margin-bottom:8px}.resume-item{display:flex;align-items:center;gap:12px;padding:16px 0;border-bottom:1px solid #edf1ed;cursor:pointer}.resume-item:last-child{border-bottom:0}.resume-item input{position:absolute;opacity:0}.resume-check{display:grid;place-items:center;width:24px;height:24px;border:1px solid #cbd8cf;border-radius:50%;color:transparent}.resume-item input:checked+.resume-check{background:var(--deep-green);border-color:var(--deep-green);color:#fff}.resume-item strong,.resume-item small{display:block}.resume-item strong{font-size:13px}.resume-item small{color:var(--muted);font-size:11px;margin-top:3px}
@media(max-width:700px){.resume-view{padding:27px 16px 35px}.resume-layout{grid-template-columns:1fr}.resume-score{padding:18px}}
 .skill-gap-view{padding:41px 42px 60px;max-width:1480px;margin:0 auto}.gap-plan-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.gap-plan-card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:20px;box-shadow:var(--shadow)}.gap-plan-top{display:flex;align-items:center;justify-content:space-between}.gap-percent{color:var(--deep-green);font-family:'Space Grotesk';font-size:12px;font-weight:700}.gap-plan-card h2{font-family:'Space Grotesk';font-size:21px;margin:18px 0 7px}.gap-plan-card p{color:var(--muted);font-size:12px;line-height:1.5;min-height:38px;margin:0 0 18px}.gap-plan-card .gap-track{height:7px;background:#e7eee9;border-radius:8px;overflow:hidden}.gap-plan-card .gap-track span{display:block;height:100%;background:var(--coral);border-radius:8px}.gap-plan-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:17px;color:var(--muted);font-size:11px}.gap-action{padding:8px 10px;font-size:11px;white-space:nowrap}
@media(max-width:700px){.skill-gap-view{padding:27px 16px 35px}.gap-plan-grid{grid-template-columns:1fr}}
@media(max-width:700px){.jobs-view,.applications-view{padding:27px 16px 35px}.jobs-heading{gap:14px;flex-direction:column}.jobs-heading h1{font-size:27px}.jobs-toolbar{flex-direction:column}.jobs-toolbar select{padding:12px 14px}.application-stats{overflow-x:auto}.application-board{grid-template-columns:repeat(4,minmax(190px,1fr));overflow-x:auto;padding-bottom:8px}.job-result{align-items:flex-start;flex-wrap:wrap}.job-result .match-score{margin-left:auto}.job-result .chips{width:100%}}
 .applications-view{padding:41px 42px 60px;max-width:1480px;margin:0 auto}.application-stats{display:flex;gap:12px;margin-bottom:20px}.application-stat{background:#fff;border:1px solid var(--line);border-radius:9px;padding:14px 20px;min-width:110px}.application-stat strong{display:block;font-family:'Space Grotesk';font-size:24px}.application-stat span{color:var(--muted);font-size:11px}.application-board{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.application-column{background:#eef3ee;border:1px solid var(--line);border-radius:10px;padding:13px;min-height:260px}.column-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.column-heading h2{font-family:'Space Grotesk';font-size:15px;margin:0}.column-heading span{background:#fff;color:var(--muted);border-radius:12px;padding:3px 8px;font-size:10px}.application-card{background:#fff;border:1px solid var(--line);border-radius:8px;padding:14px;margin-bottom:9px;box-shadow:var(--shadow)}.application-card h3{font-family:'Space Grotesk';font-size:14px;margin:6px 0}.application-card p{color:var(--muted);font-size:11px;margin:0 0 12px}.application-card select{width:100%;border:1px solid var(--line);border-radius:5px;padding:7px;color:var(--deep-green);font-size:11px;background:#f7faf7}.column-empty{color:var(--muted);font-size:11px;text-align:center;padding-top:30px}
 .jobs-view{padding:41px 42px 60px;max-width:1480px;margin:0 auto}.jobs-heading{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:28px}.jobs-heading h1{font-family:'Space Grotesk';font-size:34px;margin:8px 0}.jobs-heading p:not(.eyebrow){color:var(--muted);margin:0}.jobs-toolbar{display:flex;gap:12px;margin-bottom:20px}.jobs-search{display:flex;align-items:center;gap:10px;flex:1;background:#fff;border:1px solid var(--line);border-radius:8px;padding:0 14px;color:var(--muted)}.jobs-search input{border:0;outline:0;background:transparent;width:100%;padding:13px 0;font:inherit;font-size:12px}.jobs-toolbar select{border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);padding:0 14px;font:inherit;font-size:12px}.jobs-results{display:grid;gap:12px}.job-result{display:flex;align-items:center;gap:16px;padding:20px;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow)}.job-result-main{flex:1}.job-result h2{font-family:'Space Grotesk';font-size:19px;margin:5px 0}.job-result p{font-size:12px;color:var(--muted);margin:0 0 13px}.job-result .match-score{display:flex;flex-direction:column;align-items:flex-end;min-width:100px}.job-apply{margin-top:12px;padding:8px 10px;font-size:11px;white-space:nowrap}.empty-jobs{text-align:center;padding:60px 20px;background:#fff;border:1px dashed #cddbd2;border-radius:10px;color:var(--muted)}.empty-jobs h2{color:var(--ink);font-family:'Space Grotesk';margin:10px 0 5px}.empty-jobs p{margin:0}
 .assistant-panel{position:fixed;z-index:30;right:24px;bottom:24px;width:min(390px,calc(100vw - 32px));padding:22px;background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:0 22px 55px rgba(35,65,52,.18);transform:translateY(18px) scale(.97);opacity:0;pointer-events:none;transition:.22s ease}.assistant-panel.open{transform:translateY(0) scale(1);opacity:1;pointer-events:auto}.assistant-header{display:flex;align-items:flex-start;justify-content:space-between}.assistant-header h2{font-family:'Space Grotesk';font-size:24px;margin:4px 0 0}.assistant-intro{color:var(--muted);font-size:12px;line-height:1.5;margin:14px 0}.assistant-suggestions{display:flex;gap:7px;flex-wrap:wrap}.assistant-suggestions button{border:1px solid var(--line);background:#f7faf7;color:var(--deep-green);border-radius:7px;padding:8px 10px;font-size:11px}.assistant-form{margin-top:18px}.assistant-form label{display:block;color:var(--muted);font-size:11px;font-weight:700;margin-bottom:6px}.assistant-input{display:flex;gap:7px}.assistant-input input{min-width:0;flex:1;border:1px solid #cfddd5;border-radius:7px;padding:11px;font:inherit;font-size:12px;outline:none}.assistant-input input:focus{border-color:var(--green);box-shadow:0 0 0 3px #c8f2df}.assistant-input .primary-button{padding:0;width:40px;display:grid;place-items:center}.assistant-input .primary-button:disabled{opacity:.55;cursor:wait}.assistant-answer{margin-top:14px;padding:12px;background:#f1f7f2;border-left:3px solid var(--green);color:#40584e;font-size:12px;line-height:1.55;border-radius:0 7px 7px 0;min-height:44px}
*{box-sizing:border-box} :root{--ink:#1e2825;--muted:#71807b;--line:#e2e7e2;--paper:#f6f7f3;--white:#fff;--mint:#c8f2df;--green:#4c987c;--deep-green:#23654e;--coral:#fa8d68;--yellow:#f7d47b;--navy:#253a41;--shadow:0 12px 30px rgba(35,65,52,.07)}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif;font-size:14px}button,a{font:inherit}button{cursor:pointer}a{text-decoration:none;color:inherit}.app-shell{display:flex;min-height:100vh}.sidebar{width:246px;background:#f0f3ed;border-right:1px solid var(--line);padding:28px 14px 18px;display:flex;flex-direction:column;flex-shrink:0}.brand{display:flex;align-items:center;gap:9px;font-family:'Space Grotesk';font-size:19px;font-weight:700;letter-spacing:-.5px;padding:0 12px}.brand-mark{background:var(--deep-green);color:#fff;width:27px;height:27px;border-radius:8px;display:grid;place-items:center;font-size:15px}.brand-ai{color:var(--coral)}.profile-mini{display:flex;align-items:center;gap:10px;padding:22px 10px 24px;border-bottom:1px solid var(--line);margin-bottom:18px}.avatar,.top-avatar{background:#d5e8dd;color:#28644f;display:grid;place-items:center;border-radius:50%;font-size:11px;font-weight:700}.avatar{width:34px;height:34px}.profile-mini strong{display:block;font-size:12px}.profile-mini span{display:block;color:var(--muted);font-size:11px;margin-top:2px}.profile-mini .icon{margin-left:auto;color:#a0aaa5;font-size:14px}.nav-label{color:#97a39d;text-transform:uppercase;letter-spacing:1.1px;font-size:10px;font-weight:700;padding:0 13px;margin:0 0 8px}.secondary-label{margin-top:27px}.nav-item{display:flex;align-items:center;gap:11px;color:#64736d;font-size:12px;font-weight:600;padding:9px 12px;border-radius:8px;margin:2px 0;transition:.2s}.nav-item:hover{background:#e6ece5;color:var(--ink)}.nav-item.active{background:#d7eee3;color:var(--deep-green);font-weight:700}.nav-item .icon{font-size:15px;width:16px}.nav-count{margin-left:auto;background:#f6a17f;color:#fff;border-radius:12px;padding:2px 6px;font-size:9px}.ai-dot{margin-left:auto;width:6px;height:6px;background:var(--coral);border-radius:50%}.sidebar-bottom{margin-top:auto}.sidebar-tip{background:var(--navy);border-radius:10px;margin:18px 3px 0;padding:13px;color:#dcebe2}.tip-icon{width:25px;height:25px;background:#43615e;border-radius:7px;display:grid;place-items:center;color:#baf2d3;margin-bottom:10px}.tip-icon .icon{font-size:13px}.sidebar-tip strong{font-family:'Space Grotesk';display:block;font-size:12px}.sidebar-tip span{color:#a9bdb5;font-size:10px;display:block;line-height:1.5;margin:3px 0 10px}.tip-button{border:0;background:none;color:#a9edc9;padding:0;font-size:10px;font-weight:700}.main-content{min-width:0;flex:1}.topbar{height:78px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 42px;background:rgba(246,247,243,.76)}.breadcrumb{display:flex;align-items:center;gap:10px;color:#98a39e;font-size:12px}.breadcrumb .icon{font-size:13px}.breadcrumb strong{color:var(--ink);font-weight:600}.top-actions{display:flex;align-items:center;gap:14px}.icon-button{border:0;background:transparent;color:#81908a;width:30px;height:30px;display:grid;place-items:center;border-radius:7px}.icon-button:hover{background:#e8ede8;color:var(--ink)}.icon-button .icon{font-size:17px}.notification{position:relative}.notification span{position:absolute;right:4px;top:4px;width:5px;height:5px;background:var(--coral);border-radius:50%;border:1px solid var(--paper)}.top-avatar{width:30px;height:30px}.menu-toggle{display:none}.page-wrap{padding:41px 42px 60px;max-width:1480px;margin:0 auto}.hero-row{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:29px}.eyebrow{color:#8b9993;letter-spacing:1.15px;text-transform:uppercase;font-size:10px;font-weight:700;margin:0 0 10px}.status-pulse{display:inline-block;width:6px;height:6px;background:var(--green);border-radius:50%;margin-right:7px;vertical-align:1px}.hero-row h1{font:600 32px 'Space Grotesk';letter-spacing:-1.3px;margin:0}.wave{color:var(--coral);font-family:'DM Sans';font-size:22px;margin-left:5px}.hero-subtitle{color:var(--muted);margin:8px 0 0;font-size:13px}.outline-button,.primary-button{border:1px solid #cfddd5;background:var(--white);color:var(--deep-green);border-radius:7px;padding:10px 14px;font-weight:700;font-size:12px;display:flex;gap:8px;align-items:center}.outline-button:hover{background:#e8f3ed}.primary-button{background:var(--deep-green);border-color:var(--deep-green);color:#fff;margin-top:22px;padding:11px 15px}.primary-button:hover{background:#194e3b}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.metric-card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:18px 18px 15px;min-height:157px;box-shadow:var(--shadow);position:relative;overflow:hidden}.metric-card:before{content:'';width:70px;height:70px;position:absolute;right:-30px;top:-30px;border-radius:50%;background:#f0f7f1}.metric-top{display:flex;justify-content:space-between;color:#7d8b85;font-size:11px;font-weight:600;position:relative}.metric-top>.icon{font-size:15px;color:#a7b4ad}.metric-value{font:600 34px 'Space Grotesk';letter-spacing:-1.8px;margin:16px 0 8px}.metric-value span{font-size:17px;color:#a5b0aa;letter-spacing:-.5px;margin-left:2px}.metric-footer{display:flex;justify-content:space-between;align-items:center;gap:4px}.muted{color:#9ba6a1;font-size:10px}.pill{border-radius:4px;padding:4px 6px;font-size:9px;font-weight:700;display:inline-flex;align-items:center;gap:3px}.pill .icon{font-size:10px}.amber{background:#fff3d4;color:#a17920}.green{background:#ddf4e9;color:#398066}.text-button,.link-button{border:0;background:none;color:var(--deep-green);font-size:10px;font-weight:700;padding:0}.text-button .icon,.link-button .icon{font-size:11px;vertical-align:-1px}.progress-track,.fit-bar{height:4px;background:#eef1ed;border-radius:5px;margin-top:15px}.progress-track div{height:100%;background:var(--coral);border-radius:5px}.fit-bar span{display:block;height:100%;background:#77bd9c;border-radius:5px}.goal-value{font:600 22px 'Space Grotesk';margin:16px 0 11px;letter-spacing:-.8px}.goal-tags{display:flex;gap:4px;margin-top:15px}.goal-tags span,.chips span{background:#edf4ef;color:#5a7468;border-radius:4px;padding:4px 6px;font-size:9px}.content-grid{display:grid;grid-template-columns:minmax(0,1.62fr) minmax(265px,.8fr);gap:22px;margin-top:22px}.primary-column,.secondary-column{display:flex;flex-direction:column;gap:22px}.next-action{background:var(--navy);border-radius:11px;min-height:275px;display:flex;overflow:hidden;position:relative;color:white}.action-copy{padding:28px 28px 25px;max-width:57%;position:relative;z-index:1}.eyebrow.light{color:#8db2a8}.action-copy h2{font:600 25px 'Space Grotesk';margin:2px 0 11px;letter-spacing:-.8px}.action-copy>p:not(.eyebrow){color:#b8ccc4;line-height:1.6;font-size:12px;margin:0}.action-meta{display:flex;gap:16px;color:#88a69c;font-size:10px;margin-top:16px}.action-meta span{display:flex;align-items:center;gap:5px}.action-meta .icon{font-size:12px;color:#86caad}.action-art{flex:1;position:relative;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 60% 45%,#3f625e 0,#2e4b4d 27%,transparent 60%)}.code-window{background:#172d35;border:1px solid #496263;border-radius:7px;box-shadow:0 18px 30px #182b31aa;transform:rotate(4deg);padding:14px;width:220px;line-height:1.65}.code-dots{display:flex;gap:4px;margin-bottom:10px}.code-dots b{width:5px;height:5px;background:#ef8b6f;border-radius:50%}.code-dots b:nth-child(2){background:#f2ce74}.code-dots b:nth-child(3){background:#72c49b}.code-window code{color:#d9e5da;font-size:9px}.code-purple{color:#d6a9ed}.code-green{color:#9ad8b6}.code-yellow{color:#f0cf85}.code-blue{color:#7dc5dc}.section-heading{display:flex;align-items:flex-end;justify-content:space-between}.section-heading h2{font:600 20px 'Space Grotesk';letter-spacing:-.6px;margin:0}.section-heading .eyebrow{margin-bottom:7px}.link-button{font-size:11px;margin-bottom:2px}.opportunity-list{display:flex;flex-direction:column;gap:10px}.opportunity-card{background:white;border:1px solid var(--line);border-radius:9px;padding:17px;display:flex;align-items:center;gap:14px;box-shadow:0 4px 13px rgba(35,65,52,.035)}.opportunity-icon{width:38px;height:38px;border-radius:8px;display:grid;place-items:center;flex-shrink:0}.job-icon{background:#fce4dc;color:#d97451}.internship-icon{background:#e1f0e7;color:#488c72}.opportunity-main{min-width:0;flex:1}.opportunity-title{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}.type-label{font-size:8px;letter-spacing:1px;font-weight:700;color:#98a39e}.opportunity-title h3{font:600 15px 'Space Grotesk';margin:4px 0 4px}.opportunity-title p{color:#82908a;font-size:10px;margin:0}.dot-separator{color:#c1cbc5;margin:0 3px}.match-score{text-align:right;color:var(--green);white-space:nowrap}.match-score strong{font:600 20px 'Space Grotesk';display:block}.match-score span{font-size:9px;color:#98a79f}.match-score.orange strong{color:#dc8c55}.chips{display:flex;gap:5px;margin-top:12px;flex-wrap:wrap}.round-arrow{width:29px;height:29px;background:#f4f7f3;color:var(--deep-green);border:0;border-radius:50%;display:grid;place-items:center}.round-arrow .icon{font-size:14px}.journey-card,.gap-card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:21px 20px;box-shadow:var(--shadow)}.section-heading.compact{align-items:center}.section-heading.compact h2{font-size:17px}.icon-button.small{width:24px;height:24px}.icon-button.small .icon{font-size:16px}.journey{margin:22px 0 20px}.journey-item{display:flex;align-items:center;gap:11px;min-height:27px}.journey-node{height:22px;width:22px;border:1.5px solid #d9e1db;border-radius:50%;display:grid;place-items:center;color:#99a59f;font-size:9px;font-weight:700;flex-shrink:0}.journey-item.done .journey-node{background:#def4e8;border-color:#b3e0c9;color:#398067}.journey-item.current .journey-node{background:var(--coral);border-color:var(--coral);color:#fff}.journey-item strong{display:block;font-size:11px}.journey-item small{display:block;color:#9aa69f;font-size:9px;margin-top:1px}.journey-line{height:12px;border-left:1.5px solid #dfe6e0;margin-left:10px}.subtle-button{border:0;background:none;color:var(--deep-green);font-weight:700;font-size:10px;padding:0;display:flex;align-items:center;gap:7px}.subtle-button .icon{font-size:12px}.gap-card{padding-bottom:18px}.gap-count{font-size:9px;background:#fff0eb;color:#cb795d;border-radius:4px;padding:5px 7px}.gap-row{margin-top:20px}.gap-title{display:flex;justify-content:space-between;font-size:11px;font-weight:600}.gap-title strong{color:#d97858;font-size:10px}.gap-track{height:6px;background:#f1f3ef;border-radius:4px;margin-top:7px}.gap-track span{height:100%;display:block;background:#f3a17e;border-radius:4px}.gap-row:nth-of-type(3) .gap-track span{background:#f5c56e}.gap-card .subtle-button{margin-top:21px}.streak-card{background:#fff8e7;border:1px solid #f1e6c9;border-radius:10px;padding:15px 17px;display:flex;align-items:center;gap:10px}.streak-icon{background:#ffe0ad;color:#da8a43;width:32px;height:32px;display:grid;place-items:center;border-radius:8px}.streak-icon .icon{font-size:16px}.streak-card strong{font:600 12px 'Space Grotesk'}.streak-card p{margin:2px 0 0;color:#ad9b7a;font-size:9px}.streak-dots{display:flex;gap:4px;margin-left:auto}.streak-dots i{height:5px;width:5px;background:#e8d7ac;border-radius:50%}.streak-dots i.today{background:var(--coral);height:7px;width:7px}.toast{position:fixed;bottom:24px;right:24px;background:var(--navy);color:#fff;padding:12px 16px;border-radius:8px;box-shadow:var(--shadow);font-size:12px;display:flex;align-items:center;gap:9px;transform:translateY(90px);opacity:0;transition:.3s;z-index:10}.toast.show{transform:translateY(0);opacity:1}.toast .icon{color:#a4e4c0}.mobile-nav{display:none}
@media(max-width:1100px){.sidebar{width:218px}.topbar,.page-wrap{padding-left:28px;padding-right:28px}.metric-grid{grid-template-columns:repeat(2,1fr)}.content-grid{grid-template-columns:1fr}.secondary-column{display:grid;grid-template-columns:1fr 1fr}.streak-card{grid-column:1/-1}.next-action{min-height:260px}}
@media(max-width:700px){body{padding-bottom:68px}.sidebar{position:fixed;z-index:20;left:0;top:0;bottom:0;transform:translateX(-100%);transition:.25s;box-shadow:12px 0 30px #263d2b22}.sidebar.open{transform:translateX(0)}.topbar{height:62px;padding:0 17px}.menu-toggle{display:grid}.breadcrumb{margin-right:auto;margin-left:5px}.top-actions{gap:5px}.page-wrap{padding:27px 16px 35px}.hero-row{align-items:flex-start;margin-bottom:23px}.hero-row h1{font-size:25px}.hero-subtitle{font-size:12px}.hero-row .outline-button{font-size:0;padding:9px}.hero-row .outline-button .icon{font-size:16px}.metric-grid{gap:9px}.metric-card{padding:14px;min-height:145px}.metric-value{font-size:28px;margin-top:14px}.metric-footer{align-items:flex-end;flex-direction:column;gap:7px}.text-button{align-self:flex-start}.goal-value{font-size:18px}.content-grid{margin-top:16px;gap:16px}.next-action{min-height:385px}.action-copy{max-width:100%;padding:23px}.action-copy h2{font-size:22px}.action-art{position:absolute;right:-20px;bottom:-35px;width:235px;height:175px;opacity:.83}.code-window{transform:rotate(5deg) scale(.8)}.section-heading{align-items:flex-start;gap:10px}.section-heading h2{font-size:18px}.link-button{font-size:10px}.opportunity-card{padding:13px;gap:9px}.opportunity-icon{width:32px;height:32px}.opportunity-title h3{font-size:13px}.match-score strong{font-size:17px}.opportunity-title p{font-size:9px}.secondary-column{display:flex}.journey-card,.gap-card{padding:18px 16px}.mobile-nav{position:fixed;bottom:0;left:0;right:0;height:68px;background:#fff;border-top:1px solid var(--line);display:flex;justify-content:space-around;z-index:15;padding-top:8px}.mobile-nav a{display:flex;flex-direction:column;align-items:center;gap:5px;color:#9aa59f;font-size:9px;font-weight:600;min-width:56px}.mobile-nav a .icon{font-size:17px}.mobile-nav a.active{color:var(--deep-green)}.toast{left:16px;right:16px;bottom:82px;font-size:11px}.sidebar-tip{display:none}}
